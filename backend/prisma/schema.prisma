// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────

enum EstadoPedido {
  BORRADOR
  CONFIRMADO
  EN_PROCESO
  LISTO
  ENTREGADO
  CANCELADO
  NO_RETIRADO
}

enum TipoObservacion {
  PAGO_TARDIO
  NO_RETIRO
  CANCELACION_TARDE
  POSITIVA
  OTRO
}

// ─── Modelos ─────────────────────────────────────────

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  creadoEn     DateTime @default(now())
}

model Cliente {
  id           Int            @id @default(autoincrement())
  nombre       String
  telefono     String         @unique
  email        String?
  creadoEn     DateTime       @default(now())
  pedidos      Pedido[]
  observaciones Observacion[]
  usuarioCliente UsuarioCliente?
}

model Pedido {
  id            Int          @id @default(autoincrement())
  clienteId     Int
  descripcion   String
  precio        Decimal      @db.Decimal(10, 2)
  fechaEntrega  DateTime
  estado        EstadoPedido @default(BORRADOR)
  notas         String?
  creadoEn      DateTime     @default(now())
  actualizadoEn DateTime     @updatedAt
  cliente       Cliente      @relation(fields: [clienteId], references: [id])
  imagenes      PedidoImagen[]
}

// Fotos de referencia/evidencia subidas por el admin (ej. al entregar el
// pedido). Exclusivamente de uso interno — nunca se expone en /api/public.
model PedidoImagen {
  id          Int      @id @default(autoincrement())
  pedidoId    Int
  url         String
  descripcion String?
  createdAt   DateTime @default(now())
  pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
}

model Observacion {
  id            Int             @id @default(autoincrement())
  clienteId     Int
  tipo          TipoObservacion
  descripcion   String
  fecha         DateTime        @default(now())
  autoGenerada  Boolean         @default(false)
  cliente       Cliente         @relation(fields: [clienteId], references: [id])
}

// ─── Capa pública (catálogo + interacciones sociales) ──

model UsuarioCliente {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String
  nombre         String
  createdAt      DateTime        @default(now())
  clienteId      Int?            @unique
  cliente        Cliente?        @relation(fields: [clienteId], references: [id])
  resenas        Resena[]
  fechasEspeciales FechaEspecial[]
}

model Producto {
  id          Int             @id @default(autoincrement())
  nombre      String
  descripcion String?
  tematica    String?
  ocasion     String?
  vistas      Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  imagenes    ProductoImagen[]
  resenas     Resena[]
  likes       LikeProducto[]
  favoritos   Favorito[]

  @@index([tematica, ocasion])
}

model ProductoImagen {
  id         Int      @id @default(autoincrement())
  productoId Int
  url        String
  orden      Int      @default(0)
  createdAt  DateTime @default(now())
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Resena {
  id           Int            @id @default(autoincrement())
  productoId   Int
  usuarioId    Int
  calificacion Int
  comentario   String?
  createdAt    DateTime       @default(now())
  producto     Producto       @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario      UsuarioCliente @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  likes        LikeResena[]
}

model LikeProducto {
  productoId Int
  actorId    String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productoId, actorId])
}

model LikeResena {
  resenaId  Int
  actorId   String
  resena    Resena   @relation(fields: [resenaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([resenaId, actorId])
}

model Favorito {
  productoId Int
  actorId    String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productoId, actorId])
}

model FechaEspecial {
  id              Int            @id @default(autoincrement())
  usuarioId       Int
  descripcion     String
  fecha           DateTime
  notificadoEmail Boolean        @default(false)
  usuario         UsuarioCliente @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}