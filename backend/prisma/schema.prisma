// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL apunta al pooler de Supabase en modo transacción (puerto 6543,
// ?pgbouncer=true) — correcto para el runtime de la app, pero `prisma
// migrate *` se cuelga contra ese modo (no soporta advisory locks/prepared
// statements a nivel de sesión). directUrl usa el mismo pooler en modo
// sesión (puerto 5432, sin pgbouncer=true) solo para migraciones.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────

enum EstadoPedido {
  BORRADOR
  CONFIRMADO
  EN_PROCESO
  LISTO
  ENTREGADO
  CANCELADO
  NO_RETIRADO
}

enum TipoObservacion {
  PAGO_TARDIO
  NO_RETIRO
  CANCELACION_TARDE
  POSITIVA
  OTRO
}

enum TipoProducto {
  PASTEL
  CUPCAKE
  OTRO
}

// ─── Modelos ─────────────────────────────────────────

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  creadoEn     DateTime @default(now())
}

model Cliente {
  id             Int             @id @default(autoincrement())
  nombre         String
  telefono       String          @unique
  email          String?
  creadoEn       DateTime        @default(now())
  pedidos        Pedido[]
  observaciones  Observacion[]
  usuarioCliente UsuarioCliente?
}

model Pedido {
  id            Int            @id @default(autoincrement())
  clienteId     Int
  productoId    Int?
  descripcion   String
  precio        Decimal        @db.Decimal(10, 2)
  fechaEntrega  DateTime
  estado        EstadoPedido   @default(BORRADOR)
  notas         String?
  creadoEn      DateTime       @default(now())
  actualizadoEn DateTime       @updatedAt
  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  // Vínculo opcional al producto de catálogo — un pedido custom sin match en
  // el catálogo público sigue siendo válido sin este campo. onDelete SetNull:
  // borrar el producto no debe romper ni borrar el pedido histórico.
  producto      Producto?      @relation(fields: [productoId], references: [id], onDelete: SetNull)
  imagenes      PedidoImagen[]
}

// Fotos de referencia/evidencia subidas por el admin (ej. al entregar el
// pedido). Exclusivamente de uso interno — nunca se expone en /api/public.
model PedidoImagen {
  id          Int      @id @default(autoincrement())
  pedidoId    Int
  url         String
  descripcion String?
  createdAt   DateTime @default(now())
  pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
}

model Observacion {
  id           Int             @id @default(autoincrement())
  clienteId    Int
  tipo         TipoObservacion
  descripcion  String
  fecha        DateTime        @default(now())
  autoGenerada Boolean         @default(false)
  cliente      Cliente         @relation(fields: [clienteId], references: [id])
}

// ─── Capa pública (catálogo + interacciones sociales) ──

model UsuarioCliente {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  nombre              String
  createdAt           DateTime             @default(now())
  clienteId           Int?                 @unique
  cliente             Cliente?             @relation(fields: [clienteId], references: [id])
  resenas             Resena[]
  fechasEspeciales    FechaEspecial[]
  passwordResetTokens PasswordResetToken[]
}

// Token de un solo uso para "olvidé mi contraseña". Se guarda el hash del
// token (nunca el valor plano enviado por email), análogo a passwordHash.
model PasswordResetToken {
  id        Int            @id @default(autoincrement())
  usuarioId Int
  token     String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  usuario   UsuarioCliente @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Tematica {
  id        String             @id @default(uuid())
  nombre    String             @unique
  productos ProductoTematica[]
  creadoEn  DateTime           @default(now())
}

model Ocasion {
  id        String            @id @default(uuid())
  nombre    String            @unique
  productos ProductoOcasion[]
  creadoEn  DateTime          @default(now())
}

model ProductoTematica {
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tematicaId String
  tematica   Tematica @relation(fields: [tematicaId], references: [id], onDelete: Cascade)

  @@id([productoId, tematicaId])
  @@index([tematicaId])
}

model ProductoOcasion {
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  ocasionId  String
  ocasion    Ocasion  @relation(fields: [ocasionId], references: [id], onDelete: Cascade)

  @@id([productoId, ocasionId])
  @@index([ocasionId])
}

model Producto {
  id          Int                @id @default(autoincrement())
  nombre      String
  descripcion String?
  // @default(PASTEL) obligatorio: los productos ya existentes en producción
  // quedan clasificados como PASTEL sin backfill manual, hasta que el admin
  // los reclasifique.
  tipo        TipoProducto       @default(PASTEL)
  vistas      Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  imagenes    ProductoImagen[]
  resenas     Resena[]
  likes       LikeProducto[]
  favoritos   Favorito[]
  tematicas   ProductoTematica[]
  ocasiones   ProductoOcasion[]
  pedidos     Pedido[]
}

model ProductoImagen {
  id         Int      @id @default(autoincrement())
  productoId Int
  url        String
  orden      Int      @default(0)
  createdAt  DateTime @default(now())
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
}

model Resena {
  id           Int            @id @default(autoincrement())
  productoId   Int
  usuarioId    Int
  calificacion Int
  comentario   String?
  createdAt    DateTime       @default(now())
  producto     Producto       @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario      UsuarioCliente @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  likes        LikeResena[]
}

model LikeProducto {
  productoId Int
  actorId    String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productoId, actorId])
}

model LikeResena {
  resenaId  Int
  actorId   String
  resena    Resena   @relation(fields: [resenaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([resenaId, actorId])
}

model Favorito {
  productoId Int
  actorId    String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productoId, actorId])
}

model FechaEspecial {
  id              Int            @id @default(autoincrement())
  usuarioId       Int
  descripcion     String
  fecha           DateTime
  notificadoEmail Boolean        @default(false)
  usuario         UsuarioCliente @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  ruta      String
  metodo    String
  ip        String?
  userAgent String?
  usuarioId Int?
  creadoEn  DateTime @default(now())
}