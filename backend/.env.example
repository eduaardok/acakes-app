DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Requerida desde que el build corre `prisma migrate deploy` (ver
# package.json). Si DATABASE_URL apunta a un connection pooler en modo
# transacción (ej. Supabase Supavisor puerto 6543, ?pgbouncer=true),
# `prisma migrate *` se cuelga indefinidamente contra ese modo — DIRECT_URL
# debe ser una conexión en modo sesión (mismo host, puerto 5432 sin
# pgbouncer=true) o la conexión directa a la base, exclusiva para
# migraciones. Configurar en Render antes de desplegar este cambio, o el
# build queda colgado.
DIRECT_URL="postgresql://user:password@host:5432/dbname"

PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Supabase Storage — bucket público "productos-imagenes" (ya existe en Supabase).
# En Render ya están configuradas; para desarrollo local, tomarlas del dashboard
# de Supabase (Project Settings → API). SUPABASE_SERVICE_ROLE_KEY es secreta,
# nunca exponerla al frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cuenta Gmail dedicada para el cron de notificaciones (fechas especiales).
# SMTP_PASS es un App Password de Gmail, no la contraseña normal de la cuenta.
# Configurar manualmente en Render (no se versiona el valor real).
SMTP_USER=
SMTP_PASS=
