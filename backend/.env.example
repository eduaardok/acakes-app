DATABASE_URL="postgresql://user:password@host:5432/dbname"
PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cuenta Gmail dedicada para el cron de notificaciones (fechas especiales).
# SMTP_PASS es un App Password de Gmail, no la contraseña normal de la cuenta.
# Configurar manualmente en Render (no se versiona el valor real).
SMTP_USER=
SMTP_PASS=
